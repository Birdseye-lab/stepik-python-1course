from math import *
a, b, c = float(input()), float(input()), float(input())
D = pow(b, 2) - 4 * a * c
if D == 0:
    x = -(b / (2 * a))
    print(x)
elif D > 0:
    x1 = ((-b - sqrt(D)) / (2 * a))
    x2 = ((-b + sqrt(D)) / (2 * a))
    if max(x1, x2) == x1:
        print(x2, x1, sep = '\n')
    elif max(x2, x1) == x2:
        print(x1, x2, sep = '\n')
else:
    print("Нет корней")
