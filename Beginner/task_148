n, m = int(input()), int(input())
flag = True
for i in range(1, n):
    for j in range(1, n):
        for k in range(1, n):
            if i + 3 * j + 2 * k == m:
                print(i, ' + ', "3×", j, " + 2×", k, " = ", m, sep = '')
                flag = False
if flag:
    print("При заданных n и m решений не существует.")
