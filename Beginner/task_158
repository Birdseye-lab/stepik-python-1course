n = int(input())
r = n
p = r % 10 
counter1 = 0
counter2 = 0
counter3 = 0
counter4 = 0
counter5 = 1
counter6 = 0
while n != 0:
    if n % 10 == 3:
        counter1 += 1
    if n % 10 == p:
        counter2 +=1 
    if n % 2 == 0:
        counter3 += 1
    if n % 10 > 5:
        counter4 += n % 10
    if n % 10 > 7:
        counter5 *= n % 10 
    if n % 10 == 5 or n % 10 == 0:
        counter6 += 1
    n //= 10
print(counter1, counter2, counter3, counter4, counter5, counter6, sep ='\n')
