n = int(input())
if 0 < n <= 36:
    if n % 2 == 0:
        if n <= 10 or 19 <= n <= 28:
            print("черный")
        if 11 <= n <= 18 or 29 <= n <= 36:
            print("красный")
    if n % 2 != 0:
        if 1 <= n <= 10 or 19 <= n <= 28:
            print("красный")
        if 11 <= n <= 18 or 29 <= n <= 36:
            print("черный")
elif n == 0:
    print("зеленый")
else:
    print("ошибка ввода")
